#!/bin/sh
# PES's own pre-commit — not the app template.
#
# The app hooks check App/Packages, App/Resources/config.json, App/*.xcodeproj
# and App/Source. This repo has none of those, so copying them here was five
# no-ops wearing the costume of protection. Only what genuinely applies:
#
# Bypass (deliberately): git commit --no-verify
set -u

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED" ] && exit 0
fail=0

# Never committable, in any repo.
BLOCKED=$(printf '%s\n' "$STAGED" | grep -E "(^|/)\.DS_Store$|(^|/)\.env$|\.p8$|\.p12$|\.mobileprovision$|\.certSigningRequest$" || true)
if [ -n "$BLOCKED" ]; then
  echo "✗ These files must never be committed:"
  printf '    %s\n' $BLOCKED
  fail=1
fi

# Build artefacts from SPM/. Nearly committed 100MB of ModuleCache once already.
ARTEFACTS=$(printf '%s\n' "$STAGED" | grep -E "(^|/)\.build/|(^|/)\.swiftpm/" || true)
if [ -n "$ARTEFACTS" ]; then
  echo "✗ Swift build artefacts staged — these are gitignored for a reason:"
  printf '    %s\n' $ARTEFACTS | head -5
  fail=1
fi

MAX=$((5 * 1024 * 1024))
for f in $STAGED; do
  [ -f "$f" ] || continue
  size=$(wc -c < "$f" | tr -d ' ')
  [ "$size" -gt "$MAX" ] && { echo "✗ $f is $((size / 1024 / 1024))MB (limit 5MB)"; fail=1; }
done

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact >/dev/null 2>&1 || {
    echo "✗ gitleaks found a secret in the staged changes"; fail=1; }
fi

[ "$fail" -eq 0 ] || echo "  commit blocked — fix the above, or bypass with --no-verify"
exit "$fail"
