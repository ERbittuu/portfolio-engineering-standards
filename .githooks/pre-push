#!/bin/sh
# PES's own pre-push.
#
# The app template tests App/Packages/SYSKit; here the package lives at
# SPM/SYSKit, so the app hook would have silently tested nothing. It also
# enforces release/X.Y.Z branch names, which do not apply — PES releases from
# main via scripts/release.sh, not release branches.
#
# Bypass (deliberately): git push --no-verify
set -u
fail=0

# The repo's own consistency check: VERSION/CHANGELOG/README agreement, and
# every template parsing. It found real drift before anything ran it.
if [ -f scripts/validate.sh ]; then
  sh scripts/validate.sh >/dev/null 2>&1 || {
    echo "✗ validate.sh fails — run: bash scripts/validate.sh"; fail=1; }
fi

# SYSKit ships to every app, so a break here lands in all of them.
if [ -d SPM/SYSKit ] && command -v swift >/dev/null 2>&1; then
  if ! git diff --quiet origin/main...HEAD -- SPM/SYSKit 2>/dev/null; then
    echo "· running SYSKit tests…"
    (cd SPM/SYSKit && swift test >/dev/null 2>&1) || { echo "✗ SYSKit tests failed"; fail=1; }
  fi
fi

[ "$fail" -eq 0 ] || echo "  push blocked — fix the above, or bypass with --no-verify"
exit "$fail"
