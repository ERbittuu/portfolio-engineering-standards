#!/usr/bin/env bash
# PES pre-push hook.
#
# Escape hatch: git push --no-verify
set -uo pipefail

branch=$(git rev-parse --abbrev-ref HEAD)
fail=0

# 1. Branch name. This is not style: release.yml reads the version straight out
#    of the branch name to create a permanent tag, so "release/v2.9.0" or
#    "Release/2.9.0" produce a wrong tag or none at all. Everything else is
#    convention, and worth keeping consistent so the history reads cleanly.
case "$branch" in
  main) ;;
  release/*)
    version="${branch#release/}"
    if ! printf '%s' "$version" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$'; then
      echo "  ✗ '$branch' must be release/X.Y.Z — release.yml takes the tag from this name" >&2
      echo "    (no leading v, three numeric parts)" >&2
      fail=1
    fi
    ;;
  code/*|data/*|metadata/*|feat/*|fix/*|chore/*|ci/*|docs/*) ;;
  *)
    echo "  ✗ '$branch' does not match the convention (PLAYBOOK §3)" >&2
    echo "    use: code/ data/ metadata/ feat/ fix/ chore/ ci/ docs/ or release/X.Y.Z" >&2
    fail=1
    ;;
esac

# 2. SYSKit tests. Shared by every app, so a break here lands in all of them.
#    Runs in about a second and needs no simulator, so there is no reason to
#    find out from CI instead.
if [ -d App/Packages/SYSKit ] && command -v swift >/dev/null 2>&1; then
  if ! git diff --quiet origin/main...HEAD -- App/Packages/SYSKit 2>/dev/null; then
    echo "  · running SYSKit tests…" >&2
    # DEVELOPER_DIR is pinned because a git hook does not inherit the shell's
    # toolchain selection: swift resolves against the Command Line Tools SDK
    # while compiling with Xcode's, and the version mismatch fails the manifest
    # with an error that looks like broken code but is only a broken SDK pick.
    if ! (cd App/Packages/SYSKit && DEVELOPER_DIR="$(xcode-select -p)" swift test >/dev/null 2>&1); then
      echo "  ✗ SYSKit tests failed" >&2
      echo "    reproduce: (cd App/Packages/SYSKit && swift test)" >&2
      fail=1
    fi
  fi
fi

[ "$fail" -eq 0 ] || echo "  push blocked — fix the above, or bypass with --no-verify" >&2
exit "$fail"
